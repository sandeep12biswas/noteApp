{
  "name": "flownote",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "tsc": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:electron": "playwright test --config=e2e-electron/playwright.config.ts",
    "docs:screenshots": "node docs/guides/capture-screenshots.mjs",
    "docs:pdf": "node docs/guides/build-pdfs.mjs",
    "docs:docx": "node docs/guides/build-docx.mjs",
    "docs": "pnpm docs:screenshots && pnpm docs:pdf && pnpm docs:docx",
    "package:linux": "./scripts/linux/package.sh",
    "package:windows": "pwsh -File scripts/windows/package.ps1",
    "package:all": "./scripts/release/build-all.sh",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "@vitest/ui": "^2",
    "docx": "9.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4",
    "jsdom": "^25",
    "playwright-core": "^1",
    "typescript": "^5.7.2",
    "vitest": "^2"
  }
}
